doctype html
html(lang="ja")
  head
    meta(charset="UTF-8")
    link(rel="stylesheet"
      href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css"
      integrity="sha256-fx038NkLY4U1TCrBDiu5FWPEa9eiZu01EiLryshJbCo="
      crossorigin="anonymous")
    link(rel="stylesheet"
      href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.8.0/font/bootstrap-icons.css")
    link(rel="stylesheet" href="style.css")
    link(rel="preconnect" href="https://fonts.googleapis.com")
    link(rel="preconnect" href="https://fonts.gstatic.com" crossorigin)
    link(href="https://fonts.googleapis.com/css2?family=Kiwi+Maru:wght@400;500&display=swap" rel="stylesheet")
    title おだいばこチャット
  body.container.overflow-scroll(data-bs-theme=currentTheme style="padding-top: 72px; padding-bottom: 185px;")
    nav.navbar.fixed-top.bg-primary
      div.container-fluid
        h1.text-light.navbar-brand.mx-auto おだいばこチャット
          i.bi-chat-heart-fill.ms-1
        div.dropdown
          button.btn.btn-outline-light.dropdown-toggle(type="button" id="menu" data-bs-toggle="dropdown" aria-expanded="false") #{user}
            i.bi-gear-fill.ms-1
          ul.dropdown-menu.dropdown-menu-end(aria-labelledby="menu")
            li
              - const changeThemeText = (currentTheme === 'light' ? 'ダークモードに切り替え' : 'ライトモードに切り替え');
              a.dropdown-item(href="/changeTheme") #{changeThemeText}
              a.dropdown-item(href="/logout") ログアウト

    div.card.my-3.border-info
      div.card-body.py-2
        div.d-flex.flex-wrap.align-items-center.justify-content-between.gap-2.mb-1
          div.d-flex.align-items-center.gap-2
            if onlyCurrentTopic
              span.badge.bg-primary-subtle.text-dark
                i.bi-sparkles.me-1
                | 選択中のお題
            else
              span.badge.bg-secondary
                i.bi-chat-dots.me-1
                | 全体チャット
          span.badge.rounded-pill.bg-light.text-dark.border
            i.bi-calendar-event.me-1
            | 今日のお題：#{todayTopic}
        form(method="get" action="/posts").row.g-2.align-items-center
          input(type="hidden" name="onlyCurrent" value=onlyCurrentTopic ? '1' : '0')
          div.col-12
            select.form-select.form-select-sm(name="topic" aria-label="お題を選択" onchange="this.form.submit()")
              each topic, index in topics
                option(value=index selected=(index === selectedTopicIndex)) #{topic}

    if errorMessage
      div.toast-container.position-fixed.top-0.end-0.p-3(style="z-index: 1080; margin-top: 64px;")
        div.toast.show.align-items-center.text-bg-warning.border-0(role="alert" aria-live="assertive" aria-atomic="true")
          div.d-flex
            div.toast-body
              i.bi-exclamation-triangle-fill.me-2
              | #{errorMessage}
            button.btn-close.me-2.m-auto(type="button" data-bs-dismiss="toast" aria-label="閉じる")

    each post in posts
      - const cardClass = (user === post.postedBy ? 'card my-3 border-primary' : 'card my-3')
      div(class=cardClass)
        div.card-body
          div.mb-2
            span.badge.rounded-pill.topic-badge(data-topic-tone=post.topicTone) #{post.topic}
          div.d-flex.justify-content-between
            h5.card-title #{post.postedBy}
              if post.postedBy === 'admin'
                i.bi-patch-check-fill.ms-1
            - const tooltipTitle = `<small>${post.absoluteCreatedAt}</small>`
            small.card-text.float-end(data-bs-toggle="tooltip" data-bs-placement="top" data-bs-html="true" title=tooltipTitle) #{post.relativeCreatedAt}
          p.card-text.lead #{post.content}
        - const isDeletable = (user === post.postedBy || user === 'admin')
        if isDeletable
          div.card-footer.d-flex.justify-content-end
            form(method="post" action="/posts/delete")
              input(type="hidden" name="id" value=post.id)
              input(type="hidden" name="topicIndex" value=selectedTopicIndex)
              input(type="hidden" name="onlyCurrent" value=onlyCurrentTopic ? '1' : '0')
              input(type="hidden" name="oneTimeToken" value=oneTimeToken)
              button(type="submit").btn.btn-outline-danger.btn-sm
                i.bi-trash

    div#floating-scroll-btns.d-flex.flex-column.gap-2
      button(type="button" id="scroll-top-btn" title="一番上へスクロール" aria-label="一番上へスクロール").btn.btn-outline-secondary.btn-sm.floating-scroll-btn
        i.bi-arrow-up
      button(type="button" id="scroll-bottom-btn" title="一番下へスクロール" aria-label="一番下へスクロール").btn.btn-outline-secondary.btn-sm.floating-scroll-btn
        i.bi-arrow-down
    div.fixed-bottom.p-3.bg-body.border-top
      div.container-fluid.px-0.mb-2
        div.d-flex.flex-wrap.align-items-center.justify-content-between.gap-2
          div.d-flex.align-items-center.gap-2.flex-grow-1
            span.badge.bg-primary-subtle.text-dark.text-nowrap お題
            form(method="get" action="/posts").flex-grow-1.m-0
              input(type="hidden" name="onlyCurrent" value=onlyCurrentTopic ? '1' : '0')
              select.form-select.form-select-sm(name="topic" aria-label="お題を選択" onchange="this.form.submit()")
                each topic, idx in topics
                  option(value=idx selected=(idx === selectedTopicIndex)) #{topic}
          div.d-flex.gap-2
            if onlyCurrentTopic
              a.btn.btn-sm.btn-outline-secondary.text-nowrap(href=`/posts?topic=${selectedTopicIndex}&onlyCurrent=0`) 全投稿を表示
            else
              a.btn.btn-sm.btn-outline-primary.text-nowrap(href=`/posts?topic=${selectedTopicIndex}&onlyCurrent=1`) このお題だけ表示
      form(method="post" action="/posts" name="message-form").container-fluid.row.g-2
        input(type="hidden" name="topicIndex" value=selectedTopicIndex)
        input(type="hidden" name="onlyCurrent" value=onlyCurrentTopic ? '1' : '0')
        input(type="hidden" name="oneTimeToken" value=oneTimeToken)
        div.col-12
          textarea(name="content" rows="2" placeholder=`「${selectedTopic}」に答える（最大${maxLength}文字 / Ctrl・Cmd+Enterで送信）`).form-control
        div.col-12.d-flex.justify-content-between.align-items-center.flex-wrap.gap-2
          div.d-flex.align-items-center.gap-2
            span.badge.rounded-pill.today-topic-badge.bg-light.text-dark.border
              i.bi-calendar-event.me-1
              | 今日のお題：#{todayTopic}
          div.d-flex.align-items-center.gap-2
            button(type="submit").btn.btn-primary
              i.bi-send.me-1
              | 投稿

    script(src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"
      integrity="sha256-qlPVgvl+tZTCpcxYJFdHB/m6mDe84wRr+l81VoYPTgQ="
      crossorigin="anonymous")
    script(src="nn-chat.js")